    {
      "parameters": {
        "jsCode": "// ---- CONFIG ----\nconst MAX_CHARS = 1200;                          // ~ chunk size ceiling; tune to your embedding model\nconst SUBJECT = \"جغرافيا - عالم الشمال والجنوب\";   // TODO: pull this from a Set node upstream instead of hardcoding, so the same Code node works for subject 2 later\n\n// ---- HELPERS ----\nfunction stripWatermarks(text) {\n  return text\n    .replace(/@aliwehbedu/g, '')\n    .replace(/CamScanner/gi, '')\n    .replace(/[ \\t]+\\n/g, '\\n')\n    .trim();\n}\n\nfunction isTableSection(section) {\n  return /\\|\\s*-{2,}\\s*\\|/.test(section); // has a markdown table header-separator row\n}\n\nfunction splitTableSection(section, sectionIndex) {\n  const lines = section.split('\\n').filter(l => l.trim().startsWith('|'));\n  if (lines.length < 2) return [];\n\n  const headerCells = lines[0].split('|').map(c => c.trim()).filter(Boolean);\n  const dataLines = lines.slice(2); // skip header row + separator row\n\n  return dataLines.map((line, rowIndex) => {\n    const cells = line.split('|').map(c => c.trim()).filter(Boolean);\n    const text = cells\n      .map((cell, i) => `${headerCells[i] || 'عمود ' + (i + 1)}: ${cell.replace(/<br\\/>/g, '\\n')}`)\n      .join('\\n\\n');\n    return { text, section: sectionIndex, row: rowIndex, type: 'table_row' };\n  }).filter(c => c.text.trim().length > 0);\n}\n\nfunction splitProseSection(section, sectionIndex) {\n  const headerRegex = /(?=\\*\\*\\d+[-–.]\\s)/g; // split before **1- **2- etc.\n  return section.split(headerRegex)\n    .map(p => p.trim())\n    .filter(Boolean)\n    .map((text, i) => ({ text, section: sectionIndex, row: i, type: 'prose_block' }));\n}\n\nfunction splitOversized(chunk) {\n  if (chunk.text.length <= MAX_CHARS) return [chunk];\n\n  // fallback: split on lettered sub-points أ- ب- ج- د- ه- و-\n  const subParts = chunk.text.split(/(?=[أ-ي]-\\s)/g).map(p => p.trim()).filter(Boolean);\n  if (subParts.length <= 1) {\n    const out = [];\n    for (let i = 0; i < chunk.text.length; i += MAX_CHARS) {\n      out.push({ ...chunk, text: chunk.text.slice(i, i + MAX_CHARS) });\n    }\n    return out;\n  }\n\n  // regroup sub-points into buckets close to MAX_CHARS so we don't over-fragment\n  const grouped = [];\n  let buffer = '';\n  for (const p of subParts) {\n    if (buffer && (buffer + '\\n' + p).length > MAX_CHARS) {\n      grouped.push(buffer.trim());\n      buffer = p;\n    } else {\n      buffer = buffer ? buffer + '\\n' + p : p;\n    }\n  }\n  if (buffer) grouped.push(buffer.trim());\n  return grouped.map(text => ({ ...chunk, text }));\n}\n\n// ---- MAIN ----\nconst input = $input.all()[0].json;\nconst rawMarkdown = input.markdown || input.text || '';\nconst cleaned = stripWatermarks(rawMarkdown);\n\nconst sections = cleaned.split(/\\n-{3,}\\n/).map(s => s.trim()).filter(Boolean);\n\nlet allChunks = [];\nsections.forEach((section, sectionIndex) => {\n  const rough = isTableSection(section)\n    ? splitTableSection(section, sectionIndex)\n    : splitProseSection(section, sectionIndex);\n  rough.forEach(chunk => allChunks.push(...splitOversized(chunk)));\n});\n\nreturn allChunks\n  .filter(c => c.text.replace(/\\s/g, '').length > 5) // drop empty/junk fragments\n  .map((c, i) => ({\n    json: {\n      chunk_id: `${sectionsSlug(SUBJECT)}-${c.section}-${c.row}-${i}`,\n      subject: SUBJECT,\n      section_index: c.section,\n      chunk_type: c.type,\n      text: c.text,\n      char_count: c.text.length,\n    },\n  }));\n\nfunction sectionsSlug(s) {\n  return s.replace(/\\s+/g, '_');\n}"
      },
